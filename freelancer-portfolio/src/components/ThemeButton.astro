<!-- src/components/ThemeToggle.astro -->
<button
  class="theme-button"
  id="theme-toggle"
  aria-label="Alternar entre tema escuro e claro"
  aria-pressed="false"
>
  <div class="theme-track" id="theme-track">
    <div class="star s1" aria-hidden="true"></div>
    <div class="star s2" aria-hidden="true"></div>
    <div class="star s3" aria-hidden="true"></div>
    <div class="theme-thumb">
      <div class="ray r1" aria-hidden="true"></div>
      <div class="ray r2" aria-hidden="true"></div>
      <div class="ray r3" aria-hidden="true"></div>
      <div class="ray r4" aria-hidden="true"></div>
      <span class="thumb-icon icon-moon" aria-hidden="true">🌙</span>
      <span class="thumb-icon icon-sun" aria-hidden="true">☀️</span>
    </div>
  </div>
</button>

<style>
  .theme-button {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
  }
  .theme-track {
    width: 52px;
    /* height: 28px; */
    border-radius: 99px;
    background: #1e3a5f;
    border: 1.5px solid #2d6a9f;
    position: relative;
    display: flex;
    align-items: center;
    padding: 3px;
    transition:
      background 0.4s,
      border-color 0.4s;
  }
  .theme-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #a8c8e8;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition:
      transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      background 0.4s;
  }
  .thumb-icon {
    font-size: 11px;
    line-height: 1;
    position: absolute;
    transition:
      opacity 0.2s,
      transform 0.3s;
  }
  .icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  .icon-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  .star {
    position: absolute;
    border-radius: 50%;
    background: #a8c8e8;
    transition: opacity 0.3s;
  }
  .s1 {
    width: 3px;
    height: 3px;
    top: 5px;
    right: 10px;
    opacity: 0.7;
  }
  .s2 {
    width: 2px;
    height: 2px;
    top: 10px;
    right: 6px;
    opacity: 0.5;
  }
  .s3 {
    width: 2px;
    height: 2px;
    top: 16px;
    right: 12px;
    opacity: 0.4;
  }

  .ray {
    position: absolute;
    border-radius: 99px;
    background: #f5c842;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .r1,
  .r2,
  .r3,
  .r4 {
    width: 2px;
    height: 6px;
  }
  .r1 {
    top: 3px;
    left: 50%;
    transform: translateX(-50%);
  }
  .r2 {
    bottom: 3px;
    left: 50%;
    transform: translateX(-50%);
  }
  .r3 {
    left: 3px;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
  }
  .r4 {
    right: 3px;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
  }

  /* Estado claro */
  [data-theme="light"] .theme-track {
    background: #dbeafe;
    border-color: #93c5fd;
  }
  [data-theme="light"] .theme-thumb {
    transform: translateX(24px);
    background: #f5c842;
  }
  [data-theme="light"] .icon-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  [data-theme="light"] .icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  [data-theme="light"] .star {
    opacity: 0;
  }
  [data-theme="light"] .ray {
    opacity: 1;
  }

  .theme-button:hover .theme-track {
    box-shadow: 0 0 0 3px rgba(45, 106, 159, 0.25);
  }
  .theme-button:focus-visible .theme-track {
    outline: 2px solid #2d6a9f;
    outline-offset: 3px;
  }

  .theme-track.pulse {
    animation: pulse 0.35s ease;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(45, 106, 159, 0.5);
    }
    100% {
      box-shadow: 0 0 0 8px rgba(45, 106, 159, 0);
    }
  }

  /* ✅ Troca estas regras para :global() */
  :global([data-theme="light"]) .theme-track {
    background: #dbeafe;
    border-color: #93c5fd;
  }
  :global([data-theme="light"]) .theme-thumb {
    transform: translateX(24px);
    background: #f5c842;
  }
  :global([data-theme="light"]) .icon-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  :global([data-theme="light"]) .icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  :global([data-theme="light"]) .star {
    opacity: 0;
  }
  :global([data-theme="light"]) .ray {
    opacity: 1;
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById("theme-toggle");
  const track = document.getElementById("theme-track");

  const saved = localStorage.getItem("theme");
  const system = matchMedia("(prefers-color-scheme: light)").matches
    ? "light"
    : "dark";
  const theme = saved ?? system;

  root.setAttribute("data-theme", theme);
  btn?.setAttribute("aria-pressed", String(theme === "light"));

  btn?.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
    btn.setAttribute("aria-pressed", String(next === "light"));

    track?.classList.remove("pulse");
    void track?.offsetWidth;
    track?.classList.add("pulse");
    track?.addEventListener(
      "animationend",
      () => track.classList.remove("pulse"),
      { once: true },
    );
  });
</script>
