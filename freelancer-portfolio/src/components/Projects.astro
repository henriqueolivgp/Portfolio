function getScreenshotSrc(screenshot: ScreenshotType): string {
  if (typeof screenshot === "string") return screenshot;
  return screenshot.src;
}

const tabs = [
  { id: "projetos", label: "Projetos" },
  { id: "landing-pages", label: "Landing Pages" },
] as const;

const sectionTitles: Record<Category, string> = {
  projetos: "O que já construí",
  "landing-pages": "Templates & Landing Pages",
};

const sectionDescs: Record<Category, string> = {
  projetos: "Aplicações reais em produção, com impacto mensurável.",
  "landing-pages": "Landing pages e templates prontos a usar.",
};
---

<!-- ── MODAL ──────────────────────────────────────────────── -->
<div
  id="project-modal"
  class="modal-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-hidden="true"
>
  <div class="modal-box">
    <button class="modal-close" id="modal-close" aria-label="Fechar modal">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="modal-img-wrap">
      <img
        id="modal-img"
        src=""
        alt=""
        width="1200"
        height="675"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="modal-body">
      <h2 id="modal-title" class="modal-title"></h2>
      <div class="modal-tags" id="modal-tags"></div>
      <p class="modal-desc" id="modal-desc"></p>
      <div class="modal-links" id="modal-links"></div>
    </div>
  </div>
</div>

<!-- ── SECÇÃO ─────────────────────────────────────────────── -->
<section id="projetos" aria-labelledby="projetos-h2">
  <div class="container">
    <!-- Header com título dinâmico -->
    <div class="section-header">
      <h2 id="projetos-h2">
        <span class="label">Projetos</span>
        <span id="section-title">{sectionTitles["projetos"]}</span>
      </h2>
      <p id="section-desc">{sectionDescs["projetos"]}</p>
    </div>

    <!-- Tabs -->
    <div class="tabs-wrap" role="tablist" aria-label="Filtrar por categoria">
      {
        tabs.map((tab, i) => (
          <button
            class={`tab-btn${i === 0 ? " active" : ""}`}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            data-category={tab.id}
            data-title={sectionTitles[tab.id as Category]}
            data-desc={sectionDescs[tab.id as Category]}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <!-- Grid de cards -->
    <ul class="projects-grid" role="list" id="projects-grid">
      {
        projects.map((p) => (
          <li
            class="project-card"
            data-category={p.category}
            style={p.category !== "projetos" ? "display:none" : ""}
          >
            <button
              class="project-trigger"
              aria-label={`Ver detalhes do projeto ${p.title}`}
              data-title={p.title}
              data-desc={p.desc}
              data-tags={JSON.stringify(p.tags)}
              data-demo={p.demoUrl}
              data-github={p.githubUrl}
              data-screenshot={getScreenshotSrc(p.screenshot)}
              data-alt={p.screenshotAlt}
            >
              <div class="project-img-wrap">
                {typeof p.screenshot === "string" ? (
                  <img
                    src={p.screenshot}
                    alt={p.screenshotAlt}
                    width="800"
                    height="450"
                    loading="lazy"
                    decoding="async"
                    class="project-img"
                  />
                ) : (
                  <Image
                    src={p.screenshot}
                    alt={p.screenshotAlt}
                    width={800}
                    height={450}
                    loading="lazy"
                    decoding="async"
                    class="project-img"
                  />
                )}
                <div class="project-img-overlay" aria-hidden="true" />
                <div class="project-img-hint" aria-hidden="true">
                  <span>Ver detalhes</span>
                </div>
              </div>

              <div class="project-body">
                <h3 class="project-title">{p.title}</h3>
                <p class="project-desc">{p.desc}</p>
                <ul
                  class="project-tags"
                  role="list"
                  aria-label="Tecnologias usadas"
                >
                  {p.tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              </div>
            </button>

            <div class="project-links">
              {p.demoUrl !== "#" && (
                <a
                  href={p.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ver demonstração ao vivo de ${p.title} (abre em nova janela)`}
                >
                  ↗ Demo
                </a>
              )}
              {p.githubUrl !== "#" && (
                <a
                  href={p.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ver código fonte de ${p.title} no GitHub (abre em nova janela)`}
                >
                  GitHub
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ── SECÇÃO ── */
  .section-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .label {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--accent-light);
    margin-bottom: 0.4rem;
  }
  #section-title {
    display: block;
    transition: opacity 0.2s;
  }
  #projetos {
    background: var(--surface);
  }

  /* ── TABS ── */
  .tabs-wrap {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .tab-btn {
    padding: 0.55rem 1.4rem;
    border-radius: 99px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s,
      border-color 0.2s;
    font-family: inherit;
  }
  .tab-btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .tab-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 600;
  }
  .tab-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ── GRID ── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding-left: 0;
  }

  /* ── CARD ── */
  .project-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      border-color 0.25s,
      transform 0.25s,
      opacity 0.3s;
    animation: fadeIn 0.3s ease;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .project-card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }

  .project-trigger {
    display: flex;
    flex: 1;
    flex-direction: column;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }
  .project-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    border-radius: 14px;
  }

  /* ── IMAGEM ── */
  .project-img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface2);
  }
  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .project-card:hover .project-img {
    transform: scale(1.04);
  }

  .project-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 40%,
      rgba(10, 10, 15, 0.85)
    );
  }
  .project-img-hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .project-img-hint span {
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.45rem 1rem;
    border-radius: 99px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(4px);
  }
  .project-card:hover .project-img-hint {
    opacity: 1;
  }

  /* ── CORPO ── */
  .project-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }
  .project-title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
  
    display: -webkit-box;
    -webkit-line-clamp: 2; 
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .project-desc {
    font-size: 0.875rem;
    color: var(--muted);
    flex: 1;
  }
  .project-tags {
    color: var(--text);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* ── LINKS ── */
  .project-links {
    display: flex;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--border);
  }
  .project-links a {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 600;
    transition: color 0.2s;
    text-decoration: none;
  }
  .project-links a:hover {
    color: var(--accent2);
  }

  /* ── MODAL ── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s,
      visibility 0.3s;
  }
  .modal-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .modal-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    width: 100%;
    max-width: 860px;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    transform: translateY(20px) scale(0.97);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .modal-overlay.open .modal-box {
    transform: translateY(0) scale(1);
  }

  .modal-close {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 10;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s,
      background 0.2s;
  }
  .modal-close:hover {
    color: var(--text);
    border-color: var(--accent);
    background: var(--bg);
  }
  .modal-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .modal-img-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 16px 16px 0 0;
    background: var(--bg);
  }
  .modal-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .modal-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .modal-title {
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }
  .modal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .modal-desc {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.75;
    margin: 0;
  }

  .modal-links {
    display: flex;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .modal-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  .modal-links a:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }
  .modal-link-demo {
    background: var(--accent);
    color: #fff;
  }
  .modal-link-github {
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .modal-body {
      padding: 1.25rem;
    }
    .tab-btn {
      padding: 0.48rem 1rem;
      font-size: 0.82rem;
    }
  }
</style>

<script>
  // ── TABS ──────────────────────────────────────────────────
  const tabBtns = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
  const cards = document.querySelectorAll<HTMLLIElement>(".project-card");
  const sectionTitle = document.getElementById("section-title");
  const sectionDesc = document.getElementById("section-desc");

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const category = btn.dataset.category ?? "";
      const title = btn.dataset.title ?? "";
      const desc = btn.dataset.desc ?? "";

      // Actualiza tabs activas
      tabBtns.forEach((b) => {
        b.classList.remove("active");
        b.setAttribute("aria-selected", "false");
      });
      btn.classList.add("active");
      btn.setAttribute("aria-selected", "true");

      // Actualiza título e descrição
      if (sectionTitle) sectionTitle.textContent = title;
      if (sectionDesc) sectionDesc.textContent = desc;

      // Filtra cards
      cards.forEach((card) => {
        if (card.dataset.category === category) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    });
  });

  // ── MODAL ─────────────────────────────────────────────────
  const overlay = document.getElementById("project-modal") as HTMLElement;
  const closeBtn = document.getElementById("modal-close") as HTMLButtonElement;
  const modalImg = document.getElementById("modal-img") as HTMLImageElement;
  const modalTitle = document.getElementById("modal-title") as HTMLElement;
  const modalDesc = document.getElementById("modal-desc") as HTMLElement;
  const modalTags = document.getElementById("modal-tags") as HTMLElement;
  const modalLinks = document.getElementById("modal-links") as HTMLElement;

  let lastFocused: HTMLElement | null = null;

  function openModal(data: {
    title: string;
    desc: string;
    tags: string[];
    demo: string;
    github: string;
    screenshot: string;
    alt: string;
  }) {
    lastFocused = document.activeElement as HTMLElement;
    modalImg.src = data.screenshot;
    modalImg.alt = data.alt;
    modalTitle.textContent = data.title;
    modalDesc.textContent = data.desc;
    modalTags.innerHTML = data.tags
      .map((t) => `<span class="tag">${t}</span>`)
      .join("");
    modalLinks.innerHTML = "";
    if (data.demo && data.demo !== "#") {
      modalLinks.innerHTML += `<a href="${data.demo}" target="_blank" rel="noopener noreferrer" class="modal-link-demo" aria-label="Ver demonstração de ${data.title} (abre em nova janela)">↗ Demo ao vivo</a>`;
    }
    if (data.github && data.github !== "#") {
      modalLinks.innerHTML += `<a href="${data.github}" target="_blank" rel="noopener noreferrer" class="modal-link-github" aria-label="Ver código de ${data.title} no GitHub (abre em nova janela)">GitHub</a>`;
    }
    overlay.classList.add("open");
    overlay.setAttribute("aria-hidden", "false");
    closeBtn.focus();
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    overlay.classList.remove("open");
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    lastFocused?.focus();
  }

  closeBtn.addEventListener("click", closeModal);
  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) closeModal();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay.classList.contains("open")) closeModal();
  });

  document
    .querySelectorAll<HTMLButtonElement>(".project-trigger")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        openModal({
          title: btn.dataset.title ?? "",
          desc: btn.dataset.desc ?? "",
          tags: JSON.parse(btn.dataset.tags ?? "[]"),
          demo: btn.dataset.demo ?? "#",
          github: btn.dataset.github ?? "#",
          screenshot: btn.dataset.screenshot ?? "",
          alt: btn.dataset.alt ?? "",
        });
      });
    });
</script>
