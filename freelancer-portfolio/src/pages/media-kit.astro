<script>
    const printBtn = document.getElementById("mkPrint");
    printBtn?.addEventListener("click", () => window.print());
    const yearEl = document.getElementById("mkYear");
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());
    const io = new IntersectionObserver(
        (entries) =>
            entries.forEach((e) => {
                if (e.isIntersecting) {
                    const el = e.target as HTMLElement;
                    el.style.width = el.dataset.w + "%";
                    io.unobserve(el);
                }
            }),
        { threshold: 0.3 },
    );
    document.querySelectorAll(".mk-fill").forEach((f) => io.observe(f));
</script>
