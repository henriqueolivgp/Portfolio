  <!-- Menu mobile -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <ul role="list">
      <li><a href="#sobre"><UserRound /> Sobre</a></li>
      <li><a href="#projetos"><BriefcaseBusiness /> Projetos</a></li>
      <li><a href="#servicos"><Settings /> Serviços</a></li>
      <!-- <li><a href="#depoimentos"><MessageCircleMore /> Depoimentos</a></li> -->
      <li><a href="#contato"><Phone /> Contato</a></li>
    </ul>
    <a href="mailto:joao@joaosilva.dev" class="mobile-cta">✉ Falar comigo</a>
  </div>
</header>
<!-- </header> -->

<style>
  /* --- LAYOUT PRINCIPAL --- */
  .navbar {
    display: flex;
    position: fixed;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 5rem;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
    z-index: 100;

    /* padding: 1.5rem; */
    /* padding: 0 1.5rem; Adicionado um pouco de respiro lateral */
  }

  .nav-container {
    display: flex;
    width: 80%;
    justify-content: space-between;
    justify-items: center; /* CORREÇÃO: justify-items é para Grid. Em Flex usa-se align-items */
    align-items: center;
  }

  /* --- LOGOTIPO --- */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }

  .nav-logo .logo {
    height: 60px;
    width: auto; /* Mantém a proporção da imagem */
    display: block;
  }

  .nav-name {
    font-size: larger;
    color: var(--text);
  }

  /* --- LINKS DE NAVEGAÇÃO --- */
  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none; /*remove os pontos da lista HTML */
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    text-decoration: none; /* Movido da 'ul' para a tag 'a' */
    color: var(--muted); /* Fallback caso não uses variável global de cor */
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--accent-light); /* Cor principal no hover */
  }

  /* --- ÁREA DE AÇÕES (Tema + Botão) --- */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem; /* Espaço entre o ThemeButton e o Botão Principal */
  }

  .nav-button {
    display: flex; /* Mudado de inline-block para flex */
    align-items: center; /* Centra o ícone e o texto verticalmente */
    justify-content: center;
    gap: 0.5rem; /* Dá um pequeno espaço entre o ícone e o texto */

    background-color: var(--accent);
    color: #fff;
    text-decoration: none; /* Garante que o link não tem sublinhado */
    font-family: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.55rem 1.25rem;
    border: 1px solid var(--accent);
    border-radius: var(--r, 8px);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  /* Controla o tamanho exato do ícone SVG dentro do botão */
  .nav-button svg {
    width: 1.25rem;
    height: auto;
  }

  .btn-cta:hover {
    background-color: transparent;
    color: var(--accent);
  }
  .nav-button:hover {
    background-color: transparent;
    color: var(--accent);
  }

  .nav-button:active {
    transform: translateY(0);
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .hb-line {
    width: 22px;
    height: 2px;
    border-radius: 99px;
    background: var(--text);
    transition:
      transform 0.3s,
      opacity 0.3s,
      width 0.3s;
    transform-origin: center;
  }
  .hamburger.open .hb-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.open .hb-line:nth-child(2) {
    opacity: 0;
    width: 0;
  }
  .hamburger.open .hb-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s;
    opacity: 0;
    border-top: 0.5px solid var(--border);
    background: var(--bg);
  }
  .mobile-menu.open {
    max-height: 400px;
    opacity: 1;
  }
  .mobile-menu ul {
    padding: 0.5rem 0;
  }
  .mobile-menu li {
    border-bottom: 0.5px solid var(--border);
  }
  .mobile-menu li:last-child {
    border-bottom: none;
  }
  .mobile-menu a {
    display: block;
    padding: 0.85rem 1.5rem;
    font-size: 0.95rem;
    color: #9090aa;
    font-weight: 500;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .mobile-menu a:hover {
    color: var(--text);
    background: var(--surface);
  }
  .mobile-cta {
    display: block;
    margin: 0.75rem 1.25rem;
    background: #2d6a9f;
    color: #fff;
    border-radius: 8px;
    padding: 0.75rem;
    text-align: center;
    font-weight: 600;
  }

  /* --- RESPONSIVIDADE BÁSICA --- */
@media (max-width: 900px) {

  .nav-logo .logo {
    height: 44px;
  }

  .nav-links  { display: none; }
  .hamburger  { display: flex; }
  .nav-button { display: none; }

  .nav-name {
    display: none;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: .5rem;
  }
}
</style>

<script>
  const hb = document.getElementById("hamburger");
  const menu = document.getElementById("mobile-menu");

  hb?.addEventListener("click", () => {
    const isOpen = hb.classList.toggle("open");
    menu?.classList.toggle("open", isOpen);
    hb.setAttribute("aria-expanded", String(isOpen));
    menu?.setAttribute("aria-hidden", String(!isOpen));
  });

  // Fecha ao clicar num link
  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      hb?.classList.remove("open");
      menu.classList.remove("open");
      hb?.setAttribute("aria-expanded", "false");
      menu.setAttribute("aria-hidden", "true");
    });
  });
</script>
