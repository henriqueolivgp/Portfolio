---
// src/components/Projects.astro
import { Image } from "astro:assets";
import realEstateSrc from "../assets/projects/real-state-api/insomnia.png";
import cakeStore1 from "../assets/projects/cake-store/print1.png";
import cakeStore2 from "../assets/projects/cake-store/print2.png";
import cookieStore1 from "../assets/projects/cookie-store/print1.png";
import gameStore1 from "../assets/projects/game-store/print1.png";
import triadorSaudeSrc from '../assets/projects/triador-de-saude/home.png';

type ScreenshotType = ImageMetadata | string;
type Category = "projetos" | "landing-pages";

const LandingPageImages = {
  cakeStore: {
    print1: cakeStore1,
    print2: cakeStore2,
  },
  cookieStore: {
    print1: cookieStore1,
    print2: cakeStore2,
  },
    gameStore: {
    print1: gameStore1,
  },
};

interface Project {
  title: string;
  desc: string;
  tags: string[];
  demoUrl: string;
  githubUrl: string;
  screenshot: ScreenshotType;
  screenshotAlt: string;
  category: Category;
}

const projects: Project[] = [
  // ── PROJETOS ──────────────────────────────────────────────
  {
    title: "API de um Imobiliario",
    desc: "API construída para o setor imobiliário focada em regras de negócio sólidas e gestão eficiente de bases de dados para aplicações comerciais.",
    tags: ["Node.js", "TypeScript", "API REST"],
    demoUrl: "", 
    githubUrl: "https://github.com/henriqueolivgp/Real-Estate-API",
    screenshot: realEstateSrc, 
    screenshotAlt: "Estrutura e documentação representativa da Real Estate API",
    category: "projetos",
  },
  // {
  //   title: "CyberReports",
  //   desc: "Plataforma de relatórios e denúncias de cibersegurança reestruturada para garantir uma gestão segura de dados e submissão de formulários complexos.",
  //   tags: ["Full Stack", "Segurança", "Gestão de Dados"],
  //   demoUrl: "",
  //   githubUrl: "https://github.com/henriqueolivgp/CyberReports",
  //   screenshot: cyberReportsSrc,
  //   screenshotAlt: "Screenshot da interface do dashboard e relatórios da plataforma CyberReports",
  //   category: "projetos",
  // },
  // {
  //   title: "Techquiz V2",
  //   desc: "Aplicação interativa de quizzes pensada para plataformas de e-learning ou onboarding, com foco em design dinâmico e gestão de estado eficiente.",
  //   tags: ["React", "Frontend", "UI/UX"],
  //   demoUrl: "",
  //   githubUrl: "https://github.com/henriqueolivgp/Techquiz_V2",
  //   screenshot: techquizSrc,
  //   screenshotAlt: "Screenshot da interface de perguntas e respostas do Techquiz V2",
  //   category: "projetos",
  // },
  // {
  //   title: "CineShard",
  //   desc: "Projeto focado em sistemas distribuídos, demonstrando conhecimentos avançados em arquitetura de software e engenharia backend de alta complexidade.",
  //   tags: ["Sistemas Distribuídos", "Backend", "Arquitetura"],
  //   demoUrl: "",
  //   githubUrl: "https://github.com/henriqueolivgp/CineShard",
  //   screenshot: cineShardSrc,
  //   screenshotAlt: "Screenshot representativo do sistema e estrutura do CineShard",
  //   category: "projetos",
  // },
  // {
  //   title: "Deliver App (NLW)",
  //   desc: "Aplicação de delivery focada na experiência do utilizador mobile, construída com base em tecnologias e stacks modernas.",
  //   tags: ["React Native", "TypeScript", "Mobile"],
  //   demoUrl: "",
  //   githubUrl: "https://github.com/henriqueolivgp/NLW-Deliver-app",
  //   screenshot: deliverAppSrc,
  //   screenshotAlt: "Screenshot da interface mobile da aplicação de delivery",
  //   category: "projetos",
  // },
  {
  title: 'Triador de Saúde',
  desc: 'Sistema de triagem médica que prioriza o atendimento de pacientes com base na gravidade dos sintomas, otimizando o fluxo de trabalho clínico e garantindo uma resposta ágil para casos urgentes.',
  tags: ['React', 'Node.js', 'TypeScript'], // Ajusta conforme a stack real que usaste
  demoUrl: 'https://triador-de-saude.henriqueoliv.pt', // Coloca o link do deploy se existir
  githubUrl: 'https://github.com/henriqueolivgp/Triador-de-Saude',
