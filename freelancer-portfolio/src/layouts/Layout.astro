---
// src/layouts/Base.astro
// Layout base — cabeçalho SEO completo injetado em todas as páginas

import "../style/index.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Henrique Oliveira — Desenvolvedor Full Stack Freelancer",
  description = "Portfólio de Henrique Oliveira — Full Stack Developer freelancer especializado em React, Node.js e arquiteturas modernas. Disponível para projetos remotos.",
  ogImage = "/Logo.webp", // coloca a tua imagem OG em public/og-image.webp
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-PT" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0f" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- SEO Canónico -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="pt_PT" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <title>{title}</title>

    <!--
    Fonte — preconnect antes do link para evitar render-blocking
    display=swap garante que o texto aparece imediatamente com fallback
  -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Sitemap gerado pelo @astrojs/sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- ARD / ai-catalog discovery -->
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Henrique Oliveira",
        "givenName": "Henrique",
        "familyName": "Oliveira",
        "alternateName": "henriqueoliv",
        "jobTitle": "Fullstack Developer",
        "description": "Fullstack Developer e Freelancer especializado no desenvolvimento de aplicações web modernas com React, Node.js e TypeScript.",
        "url": "https://www.henriqueoliv.pt",
        "email": "mailto:geral@henriqueoliv.pt",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Figueira da Foz",
          "addressCountry": "PT"
        },
        "sameAs": [
          "https://www.linkedin.com/in/henrique-oliv",
          "https://github.com/henriqueolivgp",
          "https://www.instagram.com/henryolivgp/"
        ],
        "knowsAbout": [
          "Web Development",
          "Frontend Development",
          "Backend Development",
          "JavaScript",
          "TypeScript",
          "React",
          "Next.js",
          "Node.js",
          "Express.js",
          "REST API",
          "PostgreSQL",
          "MongoDB",
          "Git",
          "Tailwind CSS",
          "Search Engine Optimization (SEO)"
        ],
        "knowsLanguage": [
          {
            "@type": "Language",
            "name": "Portuguese",
            "alternateName": "pt"
          }
        ],
        "worksFor": {
          "@type": "Organization",
          "name": "Freelance",
          "url": "https://www.henriqueoliv.pt"
        }
      }
    </script>
  </head>
  <body class="body-style">
    <slot />
    <script>
      (() => {
        const tools = [
          {
            name: "get_projects",
            description: "List portfolio projects with tech stack, demo and source links for Henrique Oliveira",
            inputSchema: { type: "object", properties: {}, additionalProperties: false },
            execute: async () => {
              return {
                projects: [
                  { name: "API de um Imobiliário", tech: ["Node.js","TypeScript","REST"], code: "https://github.com/henriqueolivgp/Real-Estate-API" },
                  { name: "Triador de Saúde", tech: ["React","Node.js","TypeScript"], demo: "https://triador-de-saude.vercel.app/", code: "https://github.com/henriqueolivgp/Triador-de-Saude" },
                  { name: "Landing Page — Loja de Games", tech: ["Astro","CSS"], demo: "https://gamingstore-217.pages.dev/" }
                ]
              };
            }
          },
          {
            name: "get_services",
            description: "List freelance services offered by Henrique Oliveira",
            inputSchema: { type: "object", properties: {}, additionalProperties: false },
            execute: async () => {
              return {
                services: ["Desenvolvimento Web (React/Next.js)", "Landing Pages", "Plataformas Personalizadas", "APIs & Integrações", "Otimização de Performance", "Manutenção & Suporte"],
                contact: "geral@henriqueoliv.pt"
              };
            }
          },
          {
            name: "contact",
            description: "Get contact info and navigate to contact section for hiring Henrique Oliveira",
            inputSchema: { type: "object", properties: { message: { type: "string", description: "Optional message to prefill" } }, additionalProperties: false },
            execute: async (args) => {
              const el = document.querySelector("#contacto");
              if (el) el.scrollIntoView({ behavior: "smooth" });
              else window.location.hash = "#contacto";
              return { email: "geral@henriqueoliv.pt", location: "Figueira da Foz, PT", availability: "09:00-13:00, 14:00-18:00 Europe/Lisbon", message: args?.message || null, navigated: true };
            }
          },
          {
            name: "navigate_to_section",
            description: "Navigate to a portfolio section: projetos, servicos, sobre, contacto",
            inputSchema: { type: "object", properties: { section: { type: "string", enum: ["projetos","servicos","sobre","contacto","hero"] } }, required: ["section"] },
            execute: async (args) => {
              const id = args.section;
              const el = document.getElementById(id) || document.querySelector(`#${id}`) || document.querySelector(`[data-section="${id}"]`);
              if (el) el.scrollIntoView({ behavior: "smooth" });
              else window.location.hash = `#${id}`;
              return { navigated: true, section: id };
            }
          }
        ];

        function register() {
          const ctx = navigator.modelContext;
          if (!ctx) return false;
          // New API: registerTool
          if (typeof ctx.registerTool === "function") {
            const controller = new AbortController();
            for (const t of tools) {
              try { ctx.registerTool(t, { signal: controller.signal }); } catch(e) { console.warn("WebMCP registerTool failed", e); }
            }
          }
          // Legacy API: provideContext
          if (typeof ctx.provideContext === "function") {
            try {
              ctx.provideContext({
                tools: tools.map(t => ({ name: t.name, description: t.description, inputSchema: t.inputSchema })),
                // @ts-ignore legacy execute dispatcher
                onToolCall: async (name, args) => {
                  const tool = tools.find(x => x.name === name);
                  return tool ? tool.execute(args) : { error: "unknown tool" };
                }
              });
            } catch(e) { console.warn("WebMCP provideContext failed", e); }
          }
          return true;
        }

        if (!register()) {
          window.addEventListener("modelContextReady", register, { once: true });
          // also retry after load for polyfills
          window.addEventListener("load", register, { once: true });
        }
      })();
    </script>
  </body>
</html>
