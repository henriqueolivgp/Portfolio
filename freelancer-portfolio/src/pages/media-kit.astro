---
import Layout from "../layouts/Layout.astro";
import ThemeButton from "@/components/ThemeButton.astro";
import { Image } from "astro:assets";
import avatar from "@/assets/Me.jpeg";
import triadorImg from "@/assets/projects/triador-de-saude/home.png";
import cakeImg from "@/assets/projects/cake-store/print1.png";
import estateImg from "@/assets/projects/real-state-api/insomnia.png";
---

<Layout
    title="Media Kit — Henrique Oliveira | @henriqueoliv.dev"
    description="Media Kit de Henrique Oliveira (@henriqueoliv.dev) — Full Stack Developer & Criador Tech. Métricas Instagram, audiência, formatos e contactos para parcerias com a USE T.I."
    ogImage="/Logo.webp"
>
    <nav class="mk-nav" aria-label="Navegação Media Kit">
        <div class="mk-nav-inner">
            <a class="mk-brand" href="/">
                <img
                    src="/Logo.webp"
                    alt="Henrique Oliveira"
                    width="34"
                    height="34"
                />
                <span>
                    Henrique Oliveira
                    <small>@henriqueoliv.dev · MEDIA KIT</small>
                </span>
            </a>
            <div class="mk-nav-links">
                <a href="#sobre">Sobre</a>
                <a href="#metricas">Métricas</a>
                <a href="#audiencia">Audiência</a>
                <a href="#formatos">Formatos</a>
                <a href="#projetos">Projetos</a>
                <a href="#contacto">Contacto</a>
            </div>
            <div class="mk-nav-actions">
                <ThemeButton />
                <a
                    class="mk-btn mk-btn-primary mk-no-print"
                    href="https://wa.me/351923374819"
                    target="_blank"
                    rel="noopener"
                >
                    Falar Comigo
                </a>
            </div>
        </div>
    </nav>

    <header class="mk-container mk-hero" id="topo">
        <div class="mk-hero-grid">
            <div>
                <p class="mk-eyebrow">
                    Media Kit · Para USE T.I · Atualizado Set 2026
                </p>
                <h1 class="mk-h1">
                    Full Stack Developer que também <em>cria conteúdo tech</em>.
                </h1>
                <p class="mk-sub">
                    Sou o Henrique Oliveira, freelancer em Figueira da Foz. No
                    Instagram documento a vida real de dev — builds, tutoriais,
                    reviews de ferramentas e freelance life — para uma audiência
                    jovem PT/BR 18-34. Proponho à <strong>USE T.I</strong> um
                    formato misto:{" "}
                    <strong>influência tech + execução dev</strong>.
                </p>
                <div class="mk-ctas">
                    <a
                        class="mk-btn mk-btn-primary"
                        href="https://www.instagram.com/henriqueoliv.dev/"
                        target="_blank"
                        rel="noopener"
                    >
                        ↗ @henriqueoliv.dev
                    </a>
                    <a class="mk-btn mk-btn-ghost" href="/">
                        Ver portfólio
                    </a>
                    <button
                        class="mk-btn mk-btn-ghost mk-no-print"
                        id="mkPrint"
                    >
                        ⬇ Guardar PDF
                    </button>
                </div>
                <div class="mk-badges">
                    <span>📍 Figueira da Foz, PT</span>
                    <span>🗣 PT-PT</span>
                    <span>⚡ Resposta 24h</span>
                    <span>🏷 #PUB transparente</span>
                </div>
            </div>
            <aside class="mk-profile">
                <Image
                    src={avatar}
                    alt="Henrique Oliveira"
                    width={264}
                    height={264}
                    loading="eager"
                    class="mk-avatar"
                />
                <div class="mk-handle">Henrique Oliveira</div>
                <div class="mk-role">@henriqueoliv.dev · Dev &amp; Criador</div>
                <div>
                    <span class="mk-status">
                        <span class="mk-dot"></span> Disponível para parcerias
                    </span>
                </div>
                <div class="mk-follow">
                    <div>
                        <b>157</b>
                        <span>seguidores</span>
                    </div>
                    <div>
                        <b>1.453</b>
                        <span>views 30d</span>
                    </div>
                    <div>
                        <b>82%</b>
                        <span>18-34 anos</span>
                    </div>
                </div>
                <div class="mk-mini">
                    github.com/henriqueolivgp · 27 followers
                    <br />
                    henriqueoliv.pt · 94+ Lighthouse
                </div>
            </aside>
        </div>
        <div class="mk-stats">
            <div class="mk-stat">
                <b>1.453</b>
                <span>Visualizações (30 dias)</span>
                <small>17/08 → 15/09 · IG Insights</small>
            </div>
            <div class="mk-stat">
                <b>37</b>
                <span>Interações totais</span>
                <small>18 Reels · 17 Stories · 2 Posts</small>
            </div>
            <div class="mk-stat">
                <b>45 + 7</b>
                <span>Visitas + cliques bio</span>
                <small>Intenção real de contacto</small>
            </div>
            <div class="mk-stat">
                <b>74,9%</b>
                <span>Views de seguidores</span>
                <small>Comunidade fiel + 25% novo alcance</small>
            </div>
        </div>
    </header>

    <main class="mk-container">
        <section id="sobre" class="mk-section">
            <span class="mk-label">Sobre mim</span>
            <h2 class="mk-h2">Um developer que entrega, não só que promete.</h2>
            <p class="mk-lead">
                Comecei a programar aos 18 e hoje sou freelancer full-time.
                Ajudo startups e empresas com APIs, dashboards e e-commerces
                robustos — código limpo, testado e documentado. No Instagram
                mostro o processo sem filtro: o que corre bem, os bugs, as
                ferramentas que uso (CachyOS, React, Node, TS) e a rotina
                freelancer.
            </p>
            <div class="mk-cards mk-3">
                <div class="mk-card">
                    <div class="mk-icon">💻</div>
                    <h3>Stack real</h3>
                    <p>
                        React / Next.js 95% · Node 90% · TypeScript 92% ·
                        Postgres/Mongo 87% · Docker/AWS 82% · REST/GraphQL 89%.
                    </p>
                </div>
                <div class="mk-card">
                    <div class="mk-icon">🎬</div>
                    <h3>Conteúdo diário</h3>
                    <p>
                        Stories diários (40-140 views), Reels build-in-public,
                        posts collab. Top Reel: 451 views. Frequência
                        consistente.
                    </p>
                </div>
                <div class="mk-card">
                    <div class="mk-icon">🤝</div>
                    <h3>Porquê eu para a USE T.I</h3>
                    <p>
                        Nicho tech puro, audiência PT/BR jovem, autoridade de
                        quem executa. Posso promover <em>e</em> implementar o
                        produto.
                    </p>
                </div>
            </div>
        </section>

        <section id="metricas" class="mk-section">
            <span class="mk-label">
                Métricas completas · Instagram Insights
            </span>
            <h2 class="mk-h2">Performance últimos 30 dias</h2>
            <p class="mk-lead">
                Fonte: Painel Profissional @henriqueoliv.dev. Crescimento
                líquido +0 (base estável e fiel), com pico de 508 views/dia no
                melhor dia.
            </p>
            <div class="mk-cards mk-2">
                <div class="mk-card">
                    <h3>Visualizações por formato</h3>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>Histórias</span>
                            <b>972</b>
                        </div>
                        <div class="mk-track">
                            <div class="mk-fill mk-fill-pink" data-w="96"></div>
                        </div>
                    </div>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>Reels</span>
                            <b>458</b>
                        </div>
                        <div class="mk-track">
                            <div class="mk-fill" data-w="47"></div>
                        </div>
                    </div>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>Publicações</span>
                            <b>15</b>
                        </div>
                        <div class="mk-track">
                            <div class="mk-fill" data-w="4"></div>
                        </div>
                    </div>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>Diretos</span>
                            <b>0</b>
                        </div>
                        <div class="mk-track">
                            <div class="mk-fill" data-w="0"></div>
                        </div>
                    </div>
                    <p class="mk-note">
                        Visualizadores únicos: 319 · Stories dominam o volume,
                        Reels dão alcance novo.
                    </p>
                </div>
                <div class="mk-card">
                    <h3>Interações + perfil</h3>
                    <div class="mk-kpi">
                        <b>37</b>
                        <span>interações totais</span>
                    </div>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>Reels</span>
                            <b>18</b>
                        </div>
                        <div class="mk-track">
                            <div class="mk-fill" data-w="48"></div>
                        </div>
                    </div>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>Histórias</span>
                            <b>17</b>
                        </div>
                        <div class="mk-track">
                            <div class="mk-fill mk-fill-pink" data-w="46"></div>
                        </div>
                    </div>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>Publicações</span>
                            <b>2</b>
                        </div>
                        <div class="mk-track">
                            <div class="mk-fill" data-w="6"></div>
                        </div>
                    </div>
                    <p class="mk-note">
                        Visitas ao perfil 45 · Cliques no link da bio 7 ·
                        Stories recentes: 141 / 99 / 64 / 44 views.
                    </p>
                </div>
            </div>
            <div class="mk-card" style="margin-top:14px">
                <h3>Top conteúdos do mês</h3>
                <span class="mk-tag">451 views · Boas malta! Então!</span>
                <span class="mk-tag">141 views · Muito interessante, já…</span>
                <span class="mk-tag">
                    99 views · A passear com a minha marketera
                </span>
                <span class="mk-tag">
                    78 views · Post collab @ana_beatriz.marketing
                </span>
                <span class="mk-tag">64 views · Eu utilizo CachyOS</span>
                <p class="mk-note">
                    Mix vencedor: dev humor + lifestyle + reviews de setup.
                    Ideal para integrar marcas tech de forma nativa.
                </p>
            </div>
        </section>

        <section id="audiencia" class="mk-section">
            <span class="mk-label">Audiência</span>
            <h2 class="mk-h2">Quem me segue</h2>
            <p class="mk-lead">
                Comunidade pequena, qualificada e no alvo tech: homens jovens
                PT/BR que programam ou querem entrar na área.
            </p>
            <div class="mk-cards mk-4">
                <div class="mk-card">
                    <h3>Género</h3>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>Homens</span>
                            <b>74,5%</b>
                        </div>
                        <div class="mk-track">
                            <div class="mk-fill" data-w="74.5"></div>
                        </div>
                    </div>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>Mulheres</span>
                            <b>25,5%</b>
                        </div>
                        <div class="mk-track">
                            <div
                                class="mk-fill mk-fill-pink"
                                data-w="25.5"
                            ></div>
                        </div>
                    </div>
                </div>
                <div class="mk-card">
                    <h3>🎂 Idade</h3>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>18-24</span>
                            <b>41,2%</b>
                        </div>
                        <div class="mk-track">
                            <div class="mk-fill" data-w="41.2"></div>
                        </div>
                    </div>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>25-34</span>
                            <b>41,2%</b>
                        </div>
                        <div class="mk-track">
                            <div class="mk-fill" data-w="41.2"></div>
                        </div>
                    </div>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>35-44</span>
                            <b>8,8%</b>
                        </div>
                        <div class="mk-track">
                            <div
                                class="mk-fill mk-fill-pink"
                                data-w="8.8"
                            ></div>
                        </div>
                    </div>
                    <p class="mk-note">82,4% entre 18-34.</p>
                </div>
                <div class="mk-card">
                    <h3>🌍 Países</h3>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>Portugal</span>
                            <b>54,9%</b>
                        </div>
                        <div class="mk-track">
                            <div
                                class="mk-fill mk-fill-green"
                                data-w="54.9"
                            ></div>
                        </div>
                    </div>
                    <div class="mk-bar">
                        <div class="mk-bar-top">
                            <span>Brasil</span>
                            <b>19,6%</b>
                        </div>
                        <div class="mk-track">
                            <div class="mk-fill" data-w="19.6"></div>
                        </div>
                    </div>
                    <p class="mk-note">
                        Índia 6,5% · Paquistão 3,3% · Turquia 2,6% · ~75%
                        lusófono.
                    </p>
                </div>
                <div class="mk-card">
                    <h3>⏰ Atividade (WEST)</h3>
                    <p>
                        <strong>Sextas 18-21</strong> e{" "}
                        <strong>Sábados 18-23</strong> são o pico. Ao longo do
                        dia: forte <strong>12h-21h</strong>, pico 15h-18h.
                    </p>
                    <p class="mk-note">
                        Recomendo collabs 5ª/6ª às 18h para máximo alcance.
                    </p>
                </div>
            </div>
        </section>

        <section id="formatos" class="mk-section">
            <span class="mk-label">Proposta mista para USE T.I</span>
            <h2 class="mk-h2">O que posso fazer por vocês</h2>
            <p class="mk-lead">
                Sem preços — orçamento sob consulta mediante brief. Cumpro
                sempre a lei PT: identificação <code>#PUB / #PARCERIA</code> no
                início do conteúdo.
            </p>
            <div class="mk-cards mk-2">
                <div class="mk-card">
                    <div class="mk-icon">📣</div>
                    <h3>A · Para Marcas (influência)</h3>
                    <p>
                        • UGC unboxing 30s vertical 9:16
                        <br />• Review post + stories (uso real 3-7 dias)
                        <br />• Tutorial integração (ex: API, hosting,
                        ferramenta dev)
                        <br />• Live coding Twitch + repost Reels
                        <br />• Collab post (ex: já fiz com
                        @ana_beatriz.marketing)
                    </p>
                </div>
                <div class="mk-card">
                    <div class="mk-icon">🛠</div>
                    <h3>B · Para Clientes (execução dev)</h3>
                    <p>
                        • Sites &amp; Apps React/Next.js rápidos e acessíveis
                        <br />• Landing pages SEO + conversão
                        <br />• APIs REST, Stripe, auth, webhooks + docs
                        <br />• Otimização Lighthouse / Core Web Vitals
                        <br />• Manutenção e suporte contínuo
                    </p>
                </div>
            </div>
        </section>

        <section id="projetos" class="mk-section">
            <span class="mk-label">Prova de execução</span>
            <h2 class="mk-h2">Projetos em produção</h2>
            <p class="mk-lead">
                Não sou só criador — entrego produto. 5+ projetos live, 94+
                Lighthouse.
            </p>
            <div class="mk-cards mk-3">
                <div class="mk-card">
                    <Image
                        src={triadorImg}
                        alt="Triador de Saúde"
                        width={640}
                        height={360}
                        loading="lazy"
                        class="mk-shot"
                    />
                    <h3>Triador de Saúde</h3>
                    <p>
                        Sistema de triagem médica com priorização por gravidade.
                        React + Node + TS.
                    </p>
                    <div class="mk-links">
                        <a
                            href="https://triador-de-saude.vercel.app/"
                            target="_blank"
                            rel="noopener"
                        >
                            ↗ Demo
                        </a>
                        <a
                            href="https://github.com/henriqueolivgp/Triador-de-Saude"
                            target="_blank"
                            rel="noopener"
                        >
                            GitHub
                        </a>
                    </div>
                </div>
                <div class="mk-card">
                    <Image
                        src={estateImg}
                        alt="Real Estate API"
                        width={640}
                        height={360}
                        loading="lazy"
                        class="mk-shot"
                    />
                    <h3>Real Estate API</h3>
                    <p>
                        API imobiliária com regras de negócio sólidas. Node + TS
                        + REST.
                    </p>
                    <span class="mk-tag">Node.js</span>
                    <span class="mk-tag">TypeScript</span>
                    <span class="mk-tag">REST</span>
                    <div class="mk-links">
                        <a
                            href="https://github.com/henriqueolivgp/Real-Estate-API"
                            target="_blank"
                            rel="noopener"
                        >
                            GitHub
                        </a>
                    </div>
                </div>
                <div class="mk-card">
                    <Image
                        src={cakeImg}
                        alt="Landing Loja de Bolos"
                        width={640}
                        height={360}
                        loading="lazy"
                        class="mk-shot"
                    />
                    <h3>Landing — Loja de Bolos</h3>
                    <p>
                        Landing Astro ultra-rápida, SEO e conversão. Modelo
                        replicável para clientes.
                    </p>
                    <div class="mk-links">
                        <a
                            href="https://landingpage-cake.pages.dev/"
                            target="_blank"
                            rel="noopener"
                        >
                            ↗ Demo
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="mk-section">
            <span class="mk-label">Como colaborar</span>
            <h2 class="mk-h2">Simples e rápido</h2>
            <div class="mk-timeline">
                <div>
                    <b>1 · Brief</b>
                    <p>
                        Envias objetivo, produto e prazo por WhatsApp ou email.
                    </p>
                </div>
                <div>
                    <b>2 · Proposta em 24h</b>
                    <p>
                        Respondo com formato, guião e calendário (orçamento sob
                        consulta).
                    </p>
                </div>
                <div>
                    <b>3 · Entrega + métricas</b>
                    <p>
                        Publico, entrego prints de Insights e mantenho o
                        conteúdo no perfil.
                    </p>
                </div>
            </div>
        </section>

        <section id="contacto" class="mk-section">
            <div class="mk-contact">
                <span class="mk-label">Contacto</span>
                <h2 class="mk-h2">Tens uma marca ou projeto? Vamos falar.</h2>
                <p class="mk-lead" style="margin:10px auto;max-width:56ch">
                    Respondo em menos de 24h. Manda brief da USE T.I com ideia
                    de collab ou projeto dev.
                </p>
                <div class="mk-contact-grid">
                    <a
                        class="mk-btn mk-btn-primary"
                        href="https://wa.me/351923374819"
                        target="_blank"
                        rel="noopener"
                    >
                        WhatsApp
                    </a>
                    <a
                        class="mk-btn mk-btn-ghost"
                        href="mailto:geral@henriqueoliv.pt"
                    >
                        geral@henriqueoliv.pt
                    </a>
                    <a
                        class="mk-btn mk-btn-ghost"
                        href="https://www.instagram.com/henriqueoliv.dev/"
                        target="_blank"
                        rel="noopener"
                    >
                        Instagram
                    </a>
                    <a
                        class="mk-btn mk-btn-ghost"
                        href="https://www.linkedin.com/in/henrique-oliv"
                        target="_blank"
                        rel="noopener"
                    >
                        LinkedIn
                    </a>
                    <a
                        class="mk-btn mk-btn-ghost"
                        href="https://github.com/henriqueolivgp"
                        target="_blank"
                        rel="noopener"
                    >
                        GitHub
                    </a>
                </div>
                <p class="mk-note">
                    henriqueoliv.pt/media-kit · Figueira da Foz, Portugal 🇵🇹 ·
                    Dados IG: 17/08–15/09/2026
                </p>
            </div>
        </section>
    </main>

    <footer class="mk-footer">
        <div class="mk-container mk-footer-inner">
            <span>
                © <span id="mkYear"></span> Henrique Oliveira ·
                @henriqueoliv.dev · Media Kit para USE T.I
            </span>
        </div>
    </footer>
</Layout>

<style>
    .mk-container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 22px;
    }
    .mk-nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
    }
    .mk-nav-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 12px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .mk-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-weight: 700;
        color: var(--text);
        font-family: var(--sans);
    }
    .mk-brand img {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        object-fit: cover;
    }
    .mk-brand small {
        display: block;
        font-family: var(--mono);
        font-weight: 400;
        font-size: 11px;
        color: var(--muted);
        letter-spacing: 0.06em;
    }
    .mk-nav-links {
        display: flex;
        gap: 18px;
        font-size: 14px;
    }
    .mk-nav-links a {
        color: var(--muted);
        text-decoration: none;
    }
    .mk-nav-links a:hover {
        color: var(--text);
    }
    .mk-nav-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }
    .mk-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        border: 1px solid transparent;
        cursor: pointer;
        font-family: var(--sans);
        color: var(--text);
        background: transparent;
    }
    .mk-btn-primary {
        background: #6358e8;
        color: #fff;
    }
    .mk-btn-primary:hover {
        filter: brightness(1.1);
    }
    .mk-btn-ghost {
        border-color: var(--border);
        background: var(--surface);
    }
    .mk-btn-ghost:hover {
        border-color: #6358e8;
    }
    @media (max-width: 860px) {
        .mk-nav-links {
            display: none;
        }
    }
    .mk-hero {
        padding: 48px 22px 10px;
    }
    .mk-hero-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 28px;
        align-items: center;
    }
    @media (max-width: 860px) {
        .mk-hero-grid {
            grid-template-columns: 1fr;
        }
    }
    .mk-eyebrow {
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: 0.14em;
