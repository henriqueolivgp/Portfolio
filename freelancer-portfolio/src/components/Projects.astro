  screenshotAlt: 'Interface do sistema Triador de Saúde mostrando a avaliação e classificação de pacientes',
  category: 'projetos',
},

  // ── LANDING PAGES ─────────────────────────────────────────
  {
    title: "Landing Page — Abertura de uma loja de bolos",
    desc: "Landing page para restaurante com menu, galeria e reservas online.",
    tags: ["Astro", "CSS"],
    demoUrl: "https://cake-shop-opening.henriqueoliv.pt/",
    githubUrl: "#",
    screenshot: LandingPageImages.cakeStore.print1,
    screenshotAlt: "Screenshot da landing page do restaurante",
    category: "landing-pages",
  },
  {
    title: "Landing Page — Loja de Cookies",
    desc: "Landing page para restaurante com menu, galeria e reservas online.",
    tags: ["Astro", "CSS"],
    demoUrl: "https://cookiestore.henriqueoliv.pt/",
    githubUrl: "#",
    screenshot: LandingPageImages.cookieStore.print1,
    screenshotAlt: "Screenshot da landing page do restaurante",
    category: "landing-pages",
  },
  {
    title: "Landing Page — Loja de Games",
    desc: "Landing page para restaurante com menu, galeria e reservas online.",
    tags: ["Astro", "CSS"],
