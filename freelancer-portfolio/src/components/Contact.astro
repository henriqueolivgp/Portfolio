<style>
  .contact-inner {
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .contact-inner p {
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .label {
    display: block; /* era flex — muda para block para ficar em linha própria */
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    font-size: 0.72rem; /* ← força o tamanho, não herda do h2 */
    font-weight: 400;
    color: var(--accent-light);
    margin-bottom: 0.4rem;
  }

  .contact-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .contact-links a:first-child {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    justify-content: center;
    padding: 0.64rem 1rem;
    font-weight: 600;
    border-radius: var(--r, 8px);
    text-decoration: none;
    transition: all 0.2s ease;

    background-color: var(--accent);
    color: #ffffff;
    border: 1px solid var(--accent);
  }

  .contact-links a:first-child:hover {
    background-color: transparent;
    color: var(--accent);
  }

  .contact-link {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    justify-content: center;
    padding: 0.64rem 1rem;
    font-weight: 600;
    border-radius: var(--r, 8px);
    text-decoration: none;
    transition: all 0.2s ease;

    /* background-color: var(--accent); */
    color: #ffffff;
    border: 1px solid var(--accent);
  }

  .contact-link:hover {
    background-color: --accent;
    color: var(--accent);
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    border-radius: var(--r, 8px);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  /* Botão Principal */
  .btn-cta {
    background-color: var(--accent);
    color: #ffffff;
    border: 1px solid var(--accent);
  }

  .btn-cta:hover {
    background-color: transparent;
    color: var(--accent);
  }
</style>
