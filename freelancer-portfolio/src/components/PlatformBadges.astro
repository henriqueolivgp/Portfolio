---
// src/components/PlatformBadges.astro

const platforms = [
  {
    name: "Zaask",
    url: "https://www.zaask.pt/user/henriqueboliveira",
    logo: "Z",
    bg: "#ff6b35",
    metric: "★★★★★",
  },
  {
    name: "Fixando",
    url: "https://www.fixando.pt/perfil/henriqueoliveira",
    logo: "F",
    bg: "#0057ff",
    metric: "★★★★★",
  },
];
---

<div class="badges-wrap" aria-label="Perfis em plataformas freelancer">
  {
    platforms.map((p) => (
      <a
        href={p.url}
        target="_blank"
        rel="noopener noreferrer"
        class="badge"
        aria-label={`Ver perfil no ${p.name} (abre em nova janela)`}
      >
        <div class="badge-logo" style={`background:${p.bg}`}>
          {p.logo}
        </div>
        <div class="badge-info">
          <span class="badge-name">{p.name}</span>
          <span class="badge-stars">{p.metric}</span>
        </div>
      </a>
    ))
  }
  </div>

  <style>
    .badges-wrap {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }

    .badges-label {
      font-size: 0.72rem;
      color: var(--muted);
      font-family: var(--mono);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-right: 0.25rem;
    }

    .badge {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border);
      border-radius: 99px; /* ← pill */
      padding: 0.35rem 0.75rem 0.35rem 0.35rem;
      text-decoration: none;
      transition:
        border-color 0.2s,
        background 0.2s,
        transform 0.2s;
    }
    .badge:hover {
      border-color: var(--accent2);
      background: rgba(255, 255, 255, 0.07);
      transform: translateY(-1px);
    }
    .badge:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    .badge-logo {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 11px;
      font-weight: 700;
      color: #fff;
    }

    .badge-info {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .badge-name {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text);
      white-space: nowrap;
    }

    .badge-stars {
      font-size: 0.65rem;
      color: #f5a623;
      letter-spacing: 0.5px;
      line-height: 1;
    }

    @media (max-width: 480px) {
      .badges-label {
        display: none;
      }
      .badge {
        padding: 0.3rem 0.65rem 0.3rem 0.3rem;
      }
    }
  </style>
</div>
